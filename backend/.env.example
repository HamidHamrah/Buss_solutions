# Copy this file and set real values as environment variables on your server.
# Never commit actual secrets to version control.

# PostgreSQL connection string (Railway injects this automatically)
ConnectionStrings__DefaultConnection=Host=YOUR_HOST;Port=5432;Database=bus_solution_dev;Username=YOUR_USER;Password=YOUR_PASSWORD

# JWT signing key — generate with: openssl rand -base64 32
Jwt__Key=REPLACE_WITH_RANDOM_32_CHAR_SECRET

# SMTP email (Brevo / Mailgun / SendGrid)
Email__Host=smtp.brevo.com
Email__Port=587
Email__Username=your@email.com
Email__Password=YOUR_SMTP_PASSWORD
