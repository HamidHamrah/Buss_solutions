# Copy this to .env.local for local development
# For production, set these as environment variables on your host (Vercel, Railway, etc.)

# URL of your deployed backend API
VITE_API_BASE=https://your-api.railway.app

# Google Maps Platform browser key (restrict by HTTP referrer). Enable: Maps JavaScript API,
# Places API (New), Routes API. Optional VITE_GOOGLE_MAP_ID for a styled map (defaults to DEMO_MAP_ID).
VITE_GOOGLE_MAPS_KEY=
